# ============================================================================
# Variables de entorno de SALA. Copiá lo que aplique a tu .env.local (local) y
# a Netlify (producción). Las marcadas [SECRETO] nunca van al cliente ni al repo.
#
# Regla de oro: las VITE_* son públicas (se compilan en el bundle del navegador).
# Todo lo demás vive SOLO en Netlify Functions.
# ============================================================================

# ── Supabase ────────────────────────────────────────────────────────────────
# Frontend (públicas):
VITE_SUPABASE_URL=https://cfihcrjbvgjiohedsjos.supabase.co
VITE_SUPABASE_ANON_KEY=
# Backend (Netlify Functions). OJO: mismo valor que VITE_SUPABASE_URL, pero con
# ESTE nombre (sin VITE_). Lo usan checkin-lector y huella-agente.
SUPABASE_URL=https://cfihcrjbvgjiohedsjos.supabase.co
# [SECRETO] service role: escritura admin sin RLS. NUNCA en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ──────────────────────────────────────────────────────────────────
# Pública (checkout en el navegador):
VITE_STRIPE_PUBLISHABLE_KEY=
# [SECRETO] API de Stripe (plataforma + Connect):
STRIPE_SECRET_KEY=
# [SECRETO] Firma de webhooks. HAY DOS, uno por flujo, con nombres distintos:
#   · _SOCIO → webhook de pagos de socios (Connect). Si falta o está mal, el
#     webhook responde 200 y NO activa ninguna membresía, SIN ERROR VISIBLE.
#   · _SAAS  → webhook de la suscripción del gym a SALA.
# NO existe un STRIPE_WEBHOOK_SECRET a secas: ese nombre no lo lee nadie.
STRIPE_WEBHOOK_SECRET_SOCIO=
STRIPE_WEBHOOK_SECRET_SAAS=
# (opcional) comisión de SALA sobre el cobro del socio, en %. Default 0.
SALA_SOCIO_FEE_PERCENT=
# (opcional) URL base para las URLs de retorno de Stripe. Default: el origin.
APP_URL=

# ── QR de acceso ────────────────────────────────────────────────────────────
# [SECRETO] firma los tokens QR de check-in.
QR_JWT_SECRET=

# ── Lector de huella ────────────────────────────────────────────────────────
# [SECRETO] cifra las plantillas de huella (AES-256-GCM). Generá con:
#   openssl rand -base64 32
# Si se pierde, las huellas guardadas NO se recuperan (hay que re-enrolar).
HUELLA_ENCRYPTION_KEY=

# ── Notificaciones push (Web Push / VAPID) ──────────────────────────────────
# Generá el par con: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
# [SECRETO]
VAPID_PRIVATE_KEY=
# Contacto VAPID. Default: mailto:hola@salastudio.app
VAPID_SUBJECT=

# ── Demo ────────────────────────────────────────────────────────────────────
# 'true' habilita el acceso al tenant demo público.
VITE_DEMO_ENABLED=

# ── Sentry ──────────────────────────────────────────────────────────────────
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
# Build (subida de source maps, solo en CI):
SENTRY_AUTH_TOKEN=
SENTRY_ORG=stryv-studio
SENTRY_PROJECT=ekko-studio
