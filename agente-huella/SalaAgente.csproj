<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>            <!-- WinExe: corre sin consola (icono de bandeja) -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>    <!-- solo para el NotifyIcon de la bandeja -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SalaAgente</AssemblyName>
    <RootNamespace>SalaAgente</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <!--
    DPUruNet: la librería .NET del DigitalPersona U.are.U SDK. Está publicada en
    NuGet, así que se restaura sola al compilar — sin bajar DLLs a mano ni secrets.
    (El driver/runtime NATIVO del lector igual va instalado en la PC del mostrador.)
  -->
  <ItemGroup>
    <PackageReference Include="DigitalPersona.dpUruNet" Version="3.4.4.127" />
  </ItemGroup>

  <!--
    Las nativas de DigitalPersona 3.4.4 (del NuGet) CONECTAN el lector pero NO
    capturan con el driver legacy 4.1.0.217 del gym. Su SDK U.are.U 3.2.0.89 (el
    que su programa viejo usa y SÍ captura) trae otras nativas. Metemos ESAS 3.2
    (x64, sacadas del propio instalador del gym) al publish, PISANDO las 3.4.4.
    El wrapper .NET (DPUruNet 3.4.4) se queda: la API nativa dpfpdd/dpfj es estable.
  -->
  <ItemGroup>
    <NativasDP32 Include="lib-dp-x64/*.dll" />
  </ItemGroup>
  <Target Name="ReemplazarNativasDigitalPersona" AfterTargets="Publish">
    <Copy SourceFiles="@(NativasDP32)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" />
    <Message Importance="high" Text="Nativas DigitalPersona 3.2 (del SDK del gym) copiadas al publish, reemplazando las 3.4.4." />
  </Target>

</Project>
