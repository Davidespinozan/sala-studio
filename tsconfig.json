{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@public/*": ["src/public/*"],
      "@member/*": ["src/member/*"],
      "@admin/*": ["src/admin/*"],
      "@reception/*": ["src/reception/*"],
      "@styles/*": ["src/styles/*"]
    }
  },
  "include": ["src", "e2e", "netlify"],
  // Las edge functions corren en Deno (globals propios), no en Node ni en el
  // bundle del front. Las tipa Netlify en su build, no este tsconfig.
  "exclude": ["netlify/edge-functions"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
